TELEGRAM_BOT_TOKEN=put_your_botfather_token_here
TELEGRAM_BOT_NAME=Pager Test Bot
PAGER_BASE_URL=https://api.pager.co.ua
# Optional — web UI origin for Referer/login warm-up (defaults to https://www.pager.co.ua)
# PAGER_WEB_URL=https://www.pager.co.ua
BOT_CONFIG_PATH=config/bot.config.yaml
BOT_STATE_PATH=data/chat-state.json
# Railway: add PostgreSQL service and link DATABASE_URL to the bot service
DATABASE_URL=
OCR_ENABLED=true
OCR_LANG=eng
POLL_INTERVAL_MS=2000

# --- AI Support Agent (OpenRouter or OpenAI-compatible) ---
AI_ENABLED=true
# OpenRouter: Keys → create key at https://openrouter.ai/settings/keys
AI_API_KEY=sk-or-v1-...
AI_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# Model IDs with provider prefix — see https://openrouter.ai/models
AI_MODEL=openai/gpt-4o-mini
AI_VISION_MODEL=openai/gpt-4o-mini
# Optional OpenRouter metadata (recommended)
AI_HTTP_REFERER=https://your-app.up.railway.app
AI_APP_TITLE=Pager Inbox Bot

# Direct OpenAI instead of OpenRouter:
# AI_BASE_URL=https://api.openai.com/v1/chat/completions
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
# AI_VISION_MODEL=gpt-4o-mini
