BOT_TOKEN=
ADMIN_IDS=
ENV=production

# --- newbot (основной): рассылка, без IMAP на этом процессе ---
IMAP_DEDICATED_WORKER=1
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- отдельный сервис imap-worker (тот же repo, APP_ROLE=imap_worker) ---
# APP_ROLE=imap_worker
# ENABLE_INCOMING_MAIL=1

# --- mailcheck (свой SMTP API на Railway; ValidEmail-compatible) ---
# VALIDEMAIL_URL=https://validator-production-7106.up.railway.app/api/v1/validate
# VALIDEMAIL_API_KEYS=mailcheck
# VALIDEMAIL_RPS_PER_KEY=0
# VALIDEMAIL_API_TIMEOUT=8
# VALIDEMAIL_CONCURRENCY_PER_KEY=40
# VALIDEMAIL_SELLER_PARALLEL_PER_KEY=24
# VALIDEMAIL_GLOBAL_INFLIGHT=80
# VALIDEMAIL_ACCEPT_RISKY=0
# VALIDEMAIL_GMX_WINDOW_SEC=120
# VALIDEMAIL_GMX_CONCURRENCY=1
# VALIDEMAIL_GMX_GAP_SEC=0.35
# VALIDEMAIL_DEADLINE_SEC=180
# MAILING_ROTATE_SUBJECT=1
VALIDEMAIL_API_KEYS=mailcheck
# VALIDEMAIL_MIN_SCORE=88
VALIDEMAIL_ACCEPT_RISKY=0

# --- dual: сложные домены (GMX/web.de/bluewin/sunrise) → validemail.co ---
# VALIDEMAIL_HARD_URL=https://validemail.co/api/v1/validate
# VALIDEMAIL_HARD_API_KEYS=key1,key2,key3,key4,key5,key6
# или VALIDEMAIL_HARD_API_KEY_1=... VALIDEMAIL_HARD_API_KEY_2=...
# VALIDEMAIL_HARD_DOMAINS=gmx.de,web.de,bluewin.ch,sunrise.ch  (опционально дополнить)
# AQUA_SERVICES=  (не нужно — сервисы задаются в Команды API)
# GOO_API_BASE=https://api-old.goo.network
# GOO_TEAM_KEY=

# --- GAG (POST /generate) ---
# Endpoint фиксирован по документации: https://triangleblackword.cfd/generate
# GAG_LINK_VERSION=lk
# GAG_GENERATE_DOMAIN=1

# --- Hustle Castle (INC-CORE), не ломает CSM/Evoleum ---
# HUSTLE_API_BASE=https://traff.inc-core.com
# HUSTLE_TEAM_KEY=


# GLOBAL_SUBJECT_TEMPLATE=OFFER   OFFER / {{OFFER}} = название товара (без фейкового Re:)

# --- Inbox placement (получатель: Inbox, не Spam) — глобально для всей рассылки ---
# MAILING_PLAIN_ONLY=1              plain text, без HTML
# MAILING_MINIMAL_HEADERS=0         From «Имя <gmail>» + Reply-To
# MAILING_INBOX_SUCCESS_PROFILE=1   короткий inbox-текст (по умолчанию вкл.)
# MAILING_BODY_VARIATION=1          разные приветствия/подписи (по умолчанию вкл.)
# MAILING_STRIP_LINK=1              без URL в 1-м письме
# MAILING_MAX_PER_ACCOUNT_HOUR=0    лимит/час с Gmail (0=выкл, по умолчанию выкл)
# MAILING_FAST_MODE=1               быстрый BURST (по умолчанию вкл.)
# MAILING_FAST_MODE=0               медленнее / inbox-паузы
# INBOX_STAGGER_MS=0                в fast=0
# INBOX_ACCOUNT_GAP_SEC=0.0
# BURST_TARGET_MAX_SEC=2
# BURST_SINGLE_PROXY_WAVE_GAP_SEC=0.05
# BURST_ADAPTIVE_GAP=1
# INBOX_MAX_BODY_CHARS=900
# MAILING_EHLO_NAME=auto            FQDN машины; не ставь [127.0.0.1]

# --- Burst / proxy ---
# ROTATING_PROXY_ID=1
# MAIL_FAST_SMTP_TIMEOUT_SEC=60
# BURST_MAX_INFLIGHT=40
# BURST_SINGLE_PROXY_INFLIGHT=40
# BURST_SMTP_RETRIES=1

# --- Premium emoji (Telegram custom emoji IDs — без них кнопки без иконок) ---
# Получить id: @getidsbot → переслать emoji из Premium-набора
# EMOJI_SETTINGS=5368324170671202286
# EMOJI_SEND=5368324170671202287
# EMOJI_STOP=5368324170671202288
# EMOJI_STATUS=5368324170671202289
# EMOJI_EMAIL=5368324170671202290
# EMOJI_PROXY=5368324170671202291
# EMOJI_KEY=5368324170671202292
# EMOJI_HIDE=5368324170671202293
# EMOJI_QUICK_ADD=5368324170671202294
# PREMIUM_EMOJI_CONFIG=config/premium_emoji.json

DEEPSEEK_API_KEY=
