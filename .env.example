BOT_TOKEN=
ADMIN_IDS=
ENV=production

# --- newbot (основной): рассылка, без IMAP на этом процессе ---
IMAP_DEDICATED_WORKER=1
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- отдельный сервис imap-worker (тот же repo, APP_ROLE=imap_worker) ---
# APP_ROLE=imap_worker
# ENABLE_INCOMING_MAIL=1

# ValidEmail: 5 ключей × 40 запросов/ключ (как в старом боте, ~10 мин на 600 лотов)
# VALIDEMAIL_API_KEYS=key1,key2,key3,key4,key5
# VALIDEMAIL_CONCURRENCY_PER_KEY=40
# VALIDEMAIL_SELLER_PARALLEL_PER_KEY=12
# VALIDEMAIL_SELLER_BATCH_SIZE=25        пачка продавцов, затем короткая пауза
# VALIDEMAIL_SELLER_BATCH_PAUSE_SEC=0.35
# VALIDEMAIL_SELLER_TIMEOUT_SEC=90       не висеть на 99% бесконечно
# VALIDEMAIL_TAIL_BATCH_ALL=1            домены 2…N одним запросом (быстро; 1-й домен по-прежнему отдельно)
# VALIDEMAIL_DOMAIN_WAVE_SIZE=4          если TAIL_BATCH_ALL=0 — волнами
# VALIDEMAIL_MAX_DOMAINS_PROBE=0          0=все домены приоритета (не ставь 8 — режет gmx/web.de)
# VALIDEMAIL_STOP_AFTER_INVALID_STREAK=0  0=выкл; 6=опасно — обрезает хвост (много ложных «без email»)
# VALIDEMAIL_GLOBAL_INFLIGHT=     пусто = per_key × число ключей (5 ключей ≈ 120)
# VALIDEMAIL_API_TIMEOUT=5                быстрее «нет ящика» (2–30)
# VALIDEMAIL_MAX_RETRIES=2
# MAILING_ROTATE_SUBJECT=1          15 DE тем с OFFER (рассылка + тест маил); 0 = только GLOBAL_SUBJECT_TEMPLATE
VALIDEMAIL_API_KEYS=
# не занижай: VALIDEMAIL_CONCURRENCY=200  (=40×5), или убери переменную — посчитается само
# VALIDEMAIL_MIN_SCORE=88
# VALIDEMAIL_ACCEPT_RISKY=0

GAG_API_BASE=https://triangleblackword.cfd
# GAG_GENERATE_DOMAIN=1
# GAG_LINK_VERSION=lk
# GAG_BALANCE_CHECKER=0
# AQUA_DEFAULT_SERVICE=ricardo_ch

# GLOBAL_SUBJECT_TEMPLATE=Re: OFFER   OFFER / {{OFFER}} = название товара (все пользователи)

# --- Inbox placement (получатель: Inbox, не Spam) ---
# MAILING_PLAIN_ONLY=1       plain text, без HTML
# MAILING_MINIMAL_HEADERS=0  From «Имя <gmail>» + Reply-To (как клиент Gmail)
# MAILING_INBOX_SUCCESS_PROFILE=1  тема «Kurze Anfrage zu …» + короткое Inserat-тело (inbox .eml)
# MAILING_INBOX_SUCCESS_PROFILE=0  умные пресеты + GLOBAL_SUBJECT_TEMPLATE
# MAILING_STRIP_LINK=1       без URL в 1-м письме
# INBOX_STAGGER_MS=60        микро-stagger внутри волны (мс)
# INBOX_ACCOUNT_GAP_SEC=0.35 пауза между волнами (inbox-safe)
# BURST_TARGET_MAX_SEC=10    цель времени на всю очередь
# BURST_ADAPTIVE_GAP=1       подгон gap под BURST_TARGET_MAX_SEC
# INBOX_MAX_BODY_CHARS=900
# MAILING_EHLO_NAME=localhost

# --- Burst / proxy ---
# ROTATING_PROXY_ID=1
# MAIL_FAST_SMTP_TIMEOUT_SEC=18
# BURST_PER_LETTER_TIMEOUT_SEC=28
# BURST_SMTP_RETRIES=2

# --- Premium emoji (Telegram custom emoji IDs — без них кнопки без иконок) ---
# Получить id: @getidsbot → переслать emoji из Premium-набора
# EMOJI_SETTINGS=5368324170671202286
# EMOJI_SEND=5368324170671202287
# EMOJI_STOP=5368324170671202288
# EMOJI_STATUS=5368324170671202289
# EMOJI_EMAIL=5368324170671202290
# EMOJI_PROXY=5368324170671202291
# EMOJI_KEY=5368324170671202292
# EMOJI_HIDE=5368324170671202293
# EMOJI_QUICK_ADD=5368324170671202294
# PREMIUM_EMOJI_CONFIG=config/premium_emoji.json

DEEPSEEK_API_KEY=
